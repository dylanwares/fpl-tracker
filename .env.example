# --- required ---------------------------------------------------------------
# Your FPL team / entry id — the number in the URL on your points page:
# https://fantasy.premierleague.com/entry/<THIS>/event/1
FPL_ENTRY_ID=

# The mini-league this app is about — the number in the classic-league URL:
# https://fantasy.premierleague.com/leagues/<THIS>/standings/c
FPL_PRIMARY_LEAGUE_ID=

# --- crons -----------------------------------------------------------------
# Shared secret guarding /api/cron/*. Generate one: `openssl rand -hex 32`.
# On Vercel, set this and the platform sends it as a Bearer token automatically.
# Leave empty to disable the cron routes entirely.
CRON_SECRET=

# --- persistence (production) --------------------------------------------
# Provision Vercel KV (Marketplace -> Upstash Redis) and paste its vars here.
# When absent, the app falls back to an in-memory / .data JSON store for local dev.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- optional ------------------------------------------------------------
# Cap rival fan-out to N rows either side of you in the table (big leagues).
# FPL_RIVAL_WINDOW=
# Override the outgoing User-Agent sent to the FPL API.
# FPL_USER_AGENT=
# Force a game status for testing the downtime path: live | updating | unavailable
# FPL_FORCE_STATUS=
